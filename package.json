{
  "name": "ham",
  "version": "0.1.0",
  "description": "Hack Club Account Manager: manage several Hack Club Auth accounts in one place",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "icons": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "postinstall": "node node_modules/electron/install.js"
  },
  "author": "Ingo Wolf",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cmdk": "^1.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.78.0",
    "node-html-parser": "^9.0.7",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6",
    "sonner": "^2.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "productName": "HAM",
  "homepage": "https://github.com/ingoau/ham",
  "repository": {
    "type": "git",
    "url": "https://github.com/ingoau/ham.git"
  },
  "private": true,
  "allowScripts": {
    "electron-winstaller": false,
    "fsevents": false
  }
}
